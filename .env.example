# Local development against the mock JSONBin (scripts/mock-jsonbin.mjs).
# In production, set the first three in Netlify env vars and omit JSONBIN_BASE.
# The task list and wishlist use their own bins (TASKS_BIN_ID / WISHES_BIN_ID);
# both have defaults baked into the functions, so override only if needed.
APP_PASSWORD=testpass
JSONBIN_BIN_ID=localbin
JSONBIN_MASTER_KEY=test-master-key
JSONBIN_BASE=http://localhost:9999/v3/b
